# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssr-portal

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# Password reset / OTP
RESET_TOKEN_EXPIRES_MINUTES=30
OTP_EXPIRES_MINUTES=10

# Frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:3000

# Email provider (used by the email service abstraction; leave blank to log emails to console in dev)
EMAIL_FROM=no-reply@ssrinstitute.in
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
