# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replica set required — transactions are used)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssr-portal

# JWT — generate two separate long random secrets (e.g. openssl rand -hex 64)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# Token / OTP expiry
RESET_TOKEN_EXPIRES_MINUTES=30
OTP_EXPIRES_MINUTES=10

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# Email — leave blank in dev to log emails to console instead of sending
EMAIL_FROM=no-reply@ssrinstitute.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudinary — required for file uploads (materials, task submissions)
# Get these from https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
