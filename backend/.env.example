# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssr-portal

# JWT / sessions
# JWT_SECRET: 32+ random characters (the server refuses to start outside development otherwise).
JWT_SECRET=replace-with-a-long-random-secret
# Access tokens are short-lived and held only in browser memory; the refresh-token session
# (httpOnly cookie, rotated on every use, revocable) keeps users signed in.
JWT_EXPIRES_IN=15m
SESSION_TTL_DAYS=30
# Refresh cookie SameSite: lax (frontend and API on the same site) or none (different sites,
# e.g. *.vercel.app + *.railway.app; forces Secure/HTTPS).
COOKIE_SAMESITE=lax

# Seeding: required by `npm run seed` (12+ chars, upper, lower, digit). No default exists.
SEED_PASSWORD=

# Password reset / OTP
RESET_TOKEN_EXPIRES_MINUTES=30
OTP_EXPIRES_MINUTES=10

# Frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:3000

# Email provider (used by the email service abstraction; leave blank to log emails to console in dev)
EMAIL_FROM=no-reply@ssrinstitute.in
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Cloudinary (file uploads — materials, task submissions). Leave blank in dev to get a clear
# "storage not configured" error instead of a silent failure; required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
